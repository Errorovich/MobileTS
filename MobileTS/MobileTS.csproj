<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Базовый пакет = release. У Debug к нему добавляется суффикс «.debug» (см. ниже),
         поэтому debug- и release-сборки ставятся на устройство рядом как разные приложения. -->
    <ApplicationId>ru.errorovich.MobileTS</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.1</ApplicationDisplayVersion>
    <!-- По умолчанию имя в лаунчере «MobileTS»; Debug переопределяет на «MobileTS debug»,
         чтобы две иконки было видно, какая есть какая. Подставляется в ${appLabel} манифеста. -->
    <AndroidManifestPlaceholders>appLabel=MobileTS</AndroidManifestPlaceholders>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <!-- Debug: отдельный пакет (…​.debug) и имя «MobileTS debug»; подпись — стандартный
       Android debug-ключ (по умолчанию). Можно держать рядом с release-сборкой. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationId>ru.errorovich.MobileTS.debug</ApplicationId>
    <AndroidManifestPlaceholders>appLabel=MobileTS debug</AndroidManifestPlaceholders>
  </PropertyGroup>

  <!-- Подпись Release-сборки (пакет ru.errorovich.MobileTS) вынесена в локальный signing.props:
       и сам keystore, и пароли НЕ хранятся в репозитории (см. .gitignore). Скопируй
       signing.props.sample → signing.props и впиши свои значения. Без этого файла Release
       собирается с авто-debug-ключом — как любая чистая копия без секретов. В CI те же
       свойства можно передать аргументами -p:... (они перекрывают импорт). -->
  <Import Project="$(MSBuildThisFileDirectory)signing.props" Condition="Exists('$(MSBuildThisFileDirectory)signing.props')" />

  <!-- Набор ABI релизной сборки. По умолчанию обе (универсальный APK). Для отдельной сборки под
       одну архитектуру передай -p:AbiTarget=android-arm64 (или android-x64) — см. Release.targets.
       Почему через своё свойство AbiTarget, а не напрямую -p:RuntimeIdentifiers: глобальное
       RuntimeIdentifiers из командной строки протекает в TSLib (net9.0) и роняет его сборку (MSB3030);
       AbiTarget же читает только этот проект. Только для Release — Debug деплоится через -t:Run как есть. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifiers Condition="'$(AbiTarget)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(AbiTarget)' != ''">$(AbiTarget)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TSLib\TSLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="lib/arm64-v8a/libopus.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib/armeabi-v7a/libopus.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib/x86/libopus.so">
      <Abi>x86</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib/x86_64/libopus.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.DrawerLayout" Version="1.2.0.20" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.4" />
  </ItemGroup>

  <!-- Релизная матрица APK (per-ABI + universal -> dist/): таргеты ReleaseArm64 / ReleaseX64 /
       ReleaseUniversal / ReleaseAll, запуск через dotnet build -t:<таргет>. См. Release.targets. -->
  <Import Project="$(MSBuildThisFileDirectory)Release.targets" />
</Project>