<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Хост-активити: тёмный ActionBar (белый значок «три полоски» виден на нём), светлый контент. -->
  <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
    <item name="android:colorPrimary">#2D2D2D</item>
    <item name="android:colorPrimaryDark">#1E1E1E</item>
    <item name="android:colorAccent">#C2185B</item>
  </style>

  <!-- Подпись поля в раскрытой карточке сервера. -->
  <style name="CardFieldLabel">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">#888888</item>
    <item name="android:textSize">12sp</item>
  </style>
</resources>
